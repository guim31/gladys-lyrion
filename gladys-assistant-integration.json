{
  "manifest_version": 1,
  "type": "device",
  "name": "Lyrion Music Server",
  "description": {
    "en": "Control Squeezebox and squeezelite players of Lyrion (LMS): music, volume, favorites, announcements.",
    "fr": "Pilotez les lecteurs Squeezebox et squeezelite de Lyrion (LMS) : musique, volume, favoris, annonces.",
    "de": "Steuere Squeezebox und squeezelite über Lyrion (LMS): Musik, Lautstärke, Favoriten, Durchsagen.",
    "es": "Controle los reproductores Squeezebox y squeezelite de Lyrion (LMS): música, volumen, favoritos."
  },
  "version": "1.0.1",
  "docker_image": "ghcr.io/guim31/gladys-lyrion:1.0.1",
  "gladys_version": ">=5.3.0",
  "music": { "browse": true, "search": true, "queue": true, "append": true },
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-lyrion/main/cover.png",
  "categories": ["multimedia"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Connect your Lyrion server",
        "fr": "Connecter votre serveur Lyrion",
        "de": "Verbinde deinen Lyrion-Server",
        "es": "Conecte su servidor Lyrion"
      },
      "description": {
        "en": "Type the address of the computer that runs Lyrion Music Server (formerly Logitech Media Server). Every player it knows (Squeezebox, piCorePlayer, squeezelite...) then shows up in the Discovery tab.",
        "fr": "Saisissez l'adresse de l'ordinateur où tourne Lyrion Music Server (ex-Logitech Media Server). Tous les lecteurs qu'il connaît (Squeezebox, piCorePlayer, squeezelite…) apparaissent alors dans l'onglet Découverte.",
        "de": "Gib die Adresse des Rechners ein, auf dem Lyrion Music Server (früher Logitech Media Server) läuft. Alle Player, die er kennt (Squeezebox, piCorePlayer, squeezelite …), erscheinen dann im Tab Entdecken.",
        "es": "Escriba la dirección del equipo donde se ejecuta Lyrion Music Server (antes Logitech Media Server). Todos los reproductores que conoce (Squeezebox, piCorePlayer, squeezelite…) aparecerán en la pestaña Descubrir."
      },
      "links": [
        {
          "url": "https://lyrion.org/",
          "label": {
            "en": "Lyrion Music Server",
            "fr": "Lyrion Music Server",
            "de": "Lyrion Music Server",
            "es": "Lyrion Music Server"
          }
        }
      ]
    },
    {
      "key": "host",
      "type": "string",
      "label": {
        "en": "Server address",
        "fr": "Adresse du serveur",
        "de": "Serveradresse",
        "es": "Dirección del servidor"
      },
      "description": {
        "en": "IP address or host name of the Lyrion server.",
        "fr": "Adresse IP ou nom d'hôte du serveur Lyrion.",
        "de": "IP-Adresse oder Hostname des Lyrion-Servers.",
        "es": "Dirección IP o nombre de host del servidor Lyrion."
      },
      "placeholder": {
        "en": "e.g. 192.168.1.20",
        "fr": "ex. 192.168.1.20",
        "de": "z. B. 192.168.1.20",
        "es": "p. ej. 192.168.1.20"
      },
      "required": true
    },
    {
      "key": "port",
      "type": "number",
      "label": {
        "en": "Web port",
        "fr": "Port web",
        "de": "Web-Port",
        "es": "Puerto web"
      },
      "description": {
        "en": "Port of the Lyrion web interface (9000 by default).",
        "fr": "Port de l'interface web de Lyrion (9000 par défaut).",
        "de": "Port der Lyrion-Weboberfläche (standardmäßig 9000).",
        "es": "Puerto de la interfaz web de Lyrion (9000 por defecto)."
      },
      "required": false,
      "default": 9000,
      "min": 1,
      "max": 65535
    },
    {
      "key": "username",
      "type": "string",
      "label": {
        "en": "User name",
        "fr": "Nom d'utilisateur",
        "de": "Benutzername",
        "es": "Nombre de usuario"
      },
      "description": {
        "en": "Only if password protection is on in Lyrion (Settings, Advanced, Security).",
        "fr": "Seulement si la protection par mot de passe est active dans Lyrion (Réglages, Avancé, Sécurité).",
        "de": "Nur wenn der Passwortschutz in Lyrion aktiv ist (Einstellungen, Erweitert, Sicherheit).",
        "es": "Solo si la protección con contraseña está activa en Lyrion (Ajustes, Avanzado, Seguridad)."
      },
      "required": false
    },
    {
      "key": "password",
      "type": "secret",
      "label": {
        "en": "Password",
        "fr": "Mot de passe",
        "de": "Passwort",
        "es": "Contraseña"
      },
      "required": false
    },
    {
      "key": "cli_port",
      "type": "number",
      "label": {
        "en": "CLI port",
        "fr": "Port CLI",
        "de": "CLI-Port",
        "es": "Puerto CLI"
      },
      "description": {
        "en": "Lyrion announces every change on this port (9090 by default): instant updates. 0 turns it off: the players are then read every 5 seconds.",
        "fr": "Lyrion y signale chaque changement (9090 par défaut) : mises à jour immédiates. 0 le désactive : les lecteurs sont alors lus toutes les 5 secondes.",
        "de": "Lyrion meldet über diesen Port jede Änderung (standardmäßig 9090): sofortige Aktualisierung. 0 schaltet ihn ab: die Player werden dann alle 5 Sekunden gelesen.",
        "es": "Lyrion anuncia cada cambio por este puerto (9090 por defecto): actualización inmediata. 0 lo desactiva: los reproductores se leen cada 5 segundos."
      },
      "required": false,
      "default": 9090,
      "min": 0,
      "max": 65535
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the feature names",
        "fr": "Langue des noms de fonctionnalités",
        "de": "Sprache der Funktionsnamen",
        "es": "Idioma de los nombres de funciones"
      },
      "description": {
        "en": "Also used for the error messages of the scene actions.",
        "fr": "Sert aussi aux messages d'erreur des actions de scène.",
        "de": "Gilt auch für die Fehlermeldungen der Szenenaktionen.",
        "es": "También se usa en los mensajes de error de las acciones de escena."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "scene_triggers": [
    {
      "key": "playback_started",
      "label": {
        "en": "Playback started",
        "fr": "Lecture démarrée",
        "de": "Wiedergabe gestartet",
        "es": "Reproducción iniciada"
      },
      "description": {
        "en": "A player starts or resumes playing.",
        "fr": "Un lecteur commence ou reprend la lecture.",
        "de": "Ein Player beginnt oder setzt die Wiedergabe fort.",
        "es": "Un reproductor empieza o reanuda la reproducción."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Player",
            "fr": "Lecteur",
            "de": "Player",
            "es": "Reproductor"
          },
          "required": false
        }
      ],
      "variables": [
        {
          "key": "player",
          "type": "string",
          "label": {
            "en": "Player name",
            "fr": "Nom du lecteur",
            "de": "Name des Players",
            "es": "Nombre del reproductor"
          }
        },
        {
          "key": "title",
          "type": "string",
          "label": {
            "en": "Title",
            "fr": "Titre",
            "de": "Titel",
            "es": "Título"
          }
        },
        {
          "key": "artist",
          "type": "string",
          "label": {
            "en": "Artist",
            "fr": "Artiste",
            "de": "Interpret",
            "es": "Artista"
          }
        },
        {
          "key": "album",
          "type": "string",
          "label": {
            "en": "Album",
            "fr": "Album",
            "de": "Album",
            "es": "Álbum"
          }
        }
      ]
    },
    {
      "key": "playback_stopped",
      "label": {
        "en": "Playback stopped",
        "fr": "Lecture arrêtée",
        "de": "Wiedergabe beendet",
        "es": "Reproducción detenida"
      },
      "description": {
        "en": "A player stops playing: paused, stopped or turned off.",
        "fr": "Un lecteur cesse de jouer : pause, arrêt ou extinction.",
        "de": "Ein Player hört auf zu spielen: Pause, Stopp oder ausgeschaltet.",
        "es": "Un reproductor deja de sonar: pausa, parada o apagado."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Player",
            "fr": "Lecteur",
            "de": "Player",
            "es": "Reproductor"
          },
          "required": false
        },
        {
          "key": "state",
          "type": "multi_select",
          "label": {
            "en": "Reason",
            "fr": "Raison",
            "de": "Grund",
            "es": "Motivo"
          },
          "options": [
            {
              "value": "paused",
              "label": {
                "en": "Paused",
                "fr": "Mis en pause",
                "de": "Pausiert",
                "es": "En pausa"
              }
            },
            {
              "value": "stopped",
              "label": {
                "en": "Stopped",
                "fr": "Arrêté",
                "de": "Gestoppt",
                "es": "Detenido"
              }
            },
            {
              "value": "off",
              "label": {
                "en": "Turned off",
                "fr": "Éteint",
                "de": "Ausgeschaltet",
                "es": "Apagado"
              }
            }
          ]
        }
      ],
      "variables": [
        {
          "key": "player",
          "type": "string",
          "label": {
            "en": "Player name",
            "fr": "Nom du lecteur",
            "de": "Name des Players",
            "es": "Nombre del reproductor"
          }
        },
        {
          "key": "title",
          "type": "string",
          "label": {
            "en": "Title",
            "fr": "Titre",
            "de": "Titel",
            "es": "Título"
          }
        },
        {
          "key": "artist",
          "type": "string",
          "label": {
            "en": "Artist",
            "fr": "Artiste",
            "de": "Interpret",
            "es": "Artista"
          }
        },
        {
          "key": "album",
          "type": "string",
          "label": {
            "en": "Album",
            "fr": "Album",
            "de": "Album",
            "es": "Álbum"
          }
        },
        {
          "key": "state",
          "type": "string",
          "label": {
            "en": "Reason (key)",
            "fr": "Raison (clé)",
            "de": "Grund (Schlüssel)",
            "es": "Motivo (clave)"
          }
        }
      ]
    },
    {
      "key": "track_changed",
      "label": {
        "en": "Song changed",
        "fr": "Morceau changé",
        "de": "Titel gewechselt",
        "es": "Canción cambiada"
      },
      "description": {
        "en": "A player starts a new song, or a radio announces a new title.",
        "fr": "Un lecteur passe à un nouveau morceau, ou une radio annonce un nouveau titre.",
        "de": "Ein Player spielt einen neuen Titel, oder ein Radio meldet einen neuen Titel.",
        "es": "Un reproductor pasa a otra canción, o una radio anuncia un título nuevo."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Player",
            "fr": "Lecteur",
            "de": "Player",
            "es": "Reproductor"
          },
          "required": false
        }
      ],
      "variables": [
        {
          "key": "player",
          "type": "string",
          "label": {
            "en": "Player name",
            "fr": "Nom du lecteur",
            "de": "Name des Players",
            "es": "Nombre del reproductor"
          }
        },
        {
          "key": "title",
          "type": "string",
          "label": {
            "en": "Title",
            "fr": "Titre",
            "de": "Titel",
            "es": "Título"
          }
        },
        {
          "key": "artist",
          "type": "string",
          "label": {
            "en": "Artist",
            "fr": "Artiste",
            "de": "Interpret",
            "es": "Artista"
          }
        },
        {
          "key": "album",
          "type": "string",
          "label": {
            "en": "Album",
            "fr": "Album",
            "de": "Album",
            "es": "Álbum"
          }
        }
      ]
    }
  ],
  "scene_actions": [
    {
      "key": "play_favorite",
      "label": {
        "en": "Play a Lyrion favorite",
        "fr": "Jouer un favori Lyrion",
        "de": "Lyrion-Favoriten abspielen",
        "es": "Reproducir un favorito de Lyrion"
      },
      "description": {
        "en": "A radio, a playlist or an album of the Lyrion favorites, by name or position.",
        "fr": "Une radio, une playlist ou un album des favoris Lyrion, par nom ou position.",
        "de": "Ein Radio, eine Playlist oder ein Album der Lyrion-Favoriten, nach Name oder Position.",
        "es": "Una radio, una lista o un álbum de los favoritos de Lyrion, por nombre o posición."
      },
      "timeout_seconds": 20,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Player",
            "fr": "Lecteur",
            "de": "Player",
            "es": "Reproductor"
          },
          "required": true
        },
        {
          "key": "favorite",
          "type": "string",
          "label": {
            "en": "Favorite (name or position)",
            "fr": "Favori (nom ou position)",
            "de": "Favorit (Name oder Position)",
            "es": "Favorito (nombre o posición)"
          },
          "placeholder": {
            "en": "e.g. FIP or 1",
            "fr": "ex. FIP ou 1",
            "de": "z. B. FIP oder 1",
            "es": "p. ej. FIP o 1"
          },
          "required": true
        }
      ],
      "outputs": [
        {
          "key": "favorite",
          "type": "string",
          "label": {
            "en": "Favorite played",
            "fr": "Favori joué",
            "de": "Gespielter Favorit",
            "es": "Favorito reproducido"
          }
        }
      ]
    },
    {
      "key": "set_volume",
      "label": {
        "en": "Set the volume",
        "fr": "Régler le volume",
        "de": "Lautstärke einstellen",
        "es": "Ajustar el volumen"
      },
      "description": {
        "en": "Of one player, or of every player when none is chosen.",
        "fr": "D'un lecteur, ou de tous les lecteurs si aucun n'est choisi.",
        "de": "Eines Players, oder aller Player, wenn keiner gewählt ist.",
        "es": "De un reproductor, o de todos si no se elige ninguno."
      },
      "timeout_seconds": 20,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Player",
            "fr": "Lecteur",
            "de": "Player",
            "es": "Reproductor"
          },
          "required": false
        },
        {
          "key": "volume",
          "type": "number",
          "label": {
            "en": "Volume (%)",
            "fr": "Volume (%)",
            "de": "Lautstärke (%)",
            "es": "Volumen (%)"
          },
          "required": true,
          "min": 0,
          "max": 100
        }
      ]
    },
    {
      "key": "pause_all",
      "label": {
        "en": "Pause every player",
        "fr": "Mettre tous les lecteurs en pause",
        "de": "Alle Player pausieren",
        "es": "Pausar todos los reproductores"
      },
      "description": {
        "en": "Every player of the Lyrion server that is playing.",
        "fr": "Tous les lecteurs du serveur Lyrion en cours de lecture.",
        "de": "Alle spielenden Player des Lyrion-Servers.",
        "es": "Todos los reproductores del servidor Lyrion que están sonando."
      },
      "timeout_seconds": 20,
      "fields": [],
      "outputs": [
        {
          "key": "paused",
          "type": "number",
          "label": {
            "en": "Players paused",
            "fr": "Lecteurs mis en pause",
            "de": "Pausierte Player",
            "es": "Reproductores pausados"
          }
        }
      ]
    },
    {
      "key": "announce",
      "label": {
        "en": "Play an announcement",
        "fr": "Diffuser une annonce",
        "de": "Durchsage abspielen",
        "es": "Reproducir un anuncio"
      },
      "description": {
        "en": "Plays an audio address (MP3...), then gives the music back where it was.",
        "fr": "Joue une adresse audio (MP3…), puis rend la musique là où elle en était.",
        "de": "Spielt eine Audioadresse (MP3 …) und setzt die Musik dann dort fort, wo sie war.",
        "es": "Reproduce una dirección de audio (MP3…) y luego devuelve la música donde estaba."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Player",
            "fr": "Lecteur",
            "de": "Player",
            "es": "Reproductor"
          },
          "required": true
        },
        {
          "key": "url",
          "type": "string",
          "label": {
            "en": "Audio address (http or https)",
            "fr": "Adresse audio (http ou https)",
            "de": "Audioadresse (http oder https)",
            "es": "Dirección de audio (http o https)"
          },
          "placeholder": {
            "en": "e.g. https://example.com/doorbell.mp3",
            "fr": "ex. https://example.com/sonnette.mp3",
            "de": "z. B. https://example.com/klingel.mp3",
            "es": "p. ej. https://example.com/timbre.mp3"
          },
          "required": true
        },
        {
          "key": "volume",
          "type": "number",
          "label": {
            "en": "Volume of the announcement (%)",
            "fr": "Volume de l'annonce (%)",
            "de": "Lautstärke der Durchsage (%)",
            "es": "Volumen del anuncio (%)"
          },
          "description": {
            "en": "Empty: the current volume.",
            "fr": "Vide : le volume actuel.",
            "de": "Leer: die aktuelle Lautstärke.",
            "es": "Vacío: el volumen actual."
          },
          "required": false,
          "min": 0,
          "max": 100
        }
      ]
    },
    {
      "key": "join_group",
      "label": {
        "en": "Join a group of players",
        "fr": "Rejoindre un groupe de lecteurs",
        "de": "Einer Player-Gruppe beitreten",
        "es": "Unirse a un grupo de reproductores"
      },
      "description": {
        "en": "The player plays in sync with another one (Lyrion synchronization).",
        "fr": "Le lecteur joue en même temps qu'un autre (synchronisation Lyrion).",
        "de": "Der Player spielt synchron mit einem anderen (Lyrion-Synchronisation).",
        "es": "El reproductor suena a la vez que otro (sincronización de Lyrion)."
      },
      "timeout_seconds": 20,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Player",
            "fr": "Lecteur",
            "de": "Player",
            "es": "Reproductor"
          },
          "required": true
        },
        {
          "key": "target",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Player to join",
            "fr": "Lecteur à rejoindre",
            "de": "Player, dem beigetreten wird",
            "es": "Reproductor al que unirse"
          },
          "required": true
        }
      ]
    },
    {
      "key": "leave_group",
      "label": {
        "en": "Leave the group",
        "fr": "Quitter le groupe",
        "de": "Gruppe verlassen",
        "es": "Salir del grupo"
      },
      "description": {
        "en": "The player plays on its own again.",
        "fr": "Le lecteur joue de nouveau seul.",
        "de": "Der Player spielt wieder allein.",
        "es": "El reproductor vuelve a sonar solo."
      },
      "timeout_seconds": 20,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Player",
            "fr": "Lecteur",
            "de": "Player",
            "es": "Reproductor"
          },
          "required": true
        }
      ]
    }
  ],
  "widgets": [
    {
      "key": "players",
      "label": {
        "en": "Lyrion players",
        "fr": "Lecteurs Lyrion",
        "de": "Lyrion-Player",
        "es": "Reproductores Lyrion"
      },
      "description": {
        "en": "What every player plays, or one player with its cover and buttons.",
        "fr": "Ce que joue chaque lecteur, ou un lecteur avec sa pochette et ses boutons.",
        "de": "Was jeder Player spielt, oder ein Player mit Cover und Tasten.",
        "es": "Lo que suena en cada reproductor, o uno con su carátula y botones."
      },
      "icon": "music",
      "action_timeout_seconds": 20,
      "settings": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Player",
            "fr": "Lecteur",
            "de": "Player",
            "es": "Reproductor"
          },
          "required": false,
          "description": {
            "en": "Empty: every player.",
            "fr": "Vide : tous les lecteurs.",
            "de": "Leer: alle Player.",
            "es": "Vacío: todos los reproductores."
          }
        }
      ]
    }
  ]
}
